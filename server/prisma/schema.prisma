generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  STAFF
  PATIENT
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIDEO
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  VOID
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

model Clinic {
  id                 String              @id @default(uuid())
  name               String
  subdomain          String              @unique
  plan               Plan                @default(FREE)
  subscriptionStatus String              @default("active")
  timezone           String              @default("UTC")
  brandName          String?
  logoUrl            String?
  contactEmail       String?
  contactPhone       String?
  currency           String              @default("usd")
  createdAt          DateTime            @default(now())
  users              User[]
  patients           Patient[]
  appointments       Appointment[]
  doctorAvailabilities DoctorAvailability[]
  scheduleOverrides  ScheduleOverride[]
  prescriptions      Prescription[]
  invoices           Invoice[]
  payments           Payment[]
}

model User {
  id            String   @id @default(uuid())
  clinicId      String?
  clinic        Clinic?  @relation(fields: [clinicId], references: [id])
  role          Role
  name          String
  email         String   @unique
  passwordHash  String?
  phone         String?
  emailVerified Boolean  @default(false)
  inviteTokenHash   String?  @unique
  inviteTokenExpiresAt DateTime?
  createdAt     DateTime @default(now())
  doctor        Doctor?
  patient       Patient?
  refreshTokens RefreshToken[]
  emailVerifications EmailVerificationToken[]
  payments      Payment[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Doctor {
  id             String            @id @default(uuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id])
  specialization String?
  licenseNo      String?
  bio            String?
  availabilities DoctorAvailability[]
  overrides      ScheduleOverride[]
  appointments   Appointment[]
  prescriptions Prescription[]
}

model DoctorAvailability {
  id           String   @id @default(uuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id])
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int      @default(30)

  @@index([doctorId, dayOfWeek])
}

model ScheduleOverride {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  date      DateTime @db.Date
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([doctorId, date])
  @@index([clinicId, date])
}

model Patient {
  id          String       @id @default(uuid())
  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id])
  name        String
  email       String?
  phone       String?
  dob         DateTime?
  gender      String?
  bloodGroup  String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  appointments Appointment[]
  prescriptions Prescription[]
  invoices      Invoice[]

  @@index([clinicId])
}

model Appointment {
  id           String            @id @default(uuid())
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(PENDING)
  type         AppointmentType   @default(IN_PERSON)
  note         String?
  cancelReason String?
  cancelledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  prescriptions Prescription[]
  invoices      Invoice[]

  @@index([clinicId, startTime])
  @@index([doctorId, startTime])
}

model Drug {
  id           String    @id @default(uuid())
  name         String    @unique
  category     String?
  uses         String?
  sideEffects  String?
  strength     String?
  packSize     String?
  manufacturer String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Prescription {
  id            String             @id @default(uuid())
  clinicId      String
  clinic        Clinic             @relation(fields: [clinicId], references: [id])
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor             @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id])
  status        PrescriptionStatus @default(DRAFT)
  scriptNo      Int?
  issuedAt      DateTime?
  notes         String?
  voidReason    String?
  voidedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  items         PrescriptionItem[]

  @@index([clinicId, createdAt])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  drugName       String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  strength       String?
  quantity       Int?
  refills        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([prescriptionId])
}

model Invoice {
  id            String        @id @default(uuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  invoiceNo     Int
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @default("usd")
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  voidReason    String?
  voidedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([clinicId, invoiceNo])
  @@index([clinicId, createdAt])
  @@index([patientId])
  @@index([appointmentId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  description String
  qty         Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(uuid())
  clinicId        String
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod @default(CASH)
  stripePaymentId String?
  note            String?
  recordedById    String?
  recordedBy      User?         @relation(fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@index([clinicId])
}
