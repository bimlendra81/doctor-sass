DATABASE_URL="mysql://root:@127.0.0.1:3307/doctor_saas"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Stripe billing (optional — leave empty for local dev, checkout returns devMode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Frontend base URL used in checkout success/cancel redirects
WEBAPP_URL="http://localhost:5173"

# Error tracking (optional)
SENTRY_DSN=""

# File storage (optional — when S3_ACCESS_KEY + S3_BUCKET are set the S3 driver is
# used for medical-record files; otherwise files stay on local disk under server/uploads/)
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_ENDPOINT=""              # optional; for R2/MinIO-compatible endpoints
S3_REGION="us-east-1"
S3_PRESIGN_TTL_SECONDS="900"
LOCAL_UPLOAD_DIR="uploads"  # relative to server/ when local driver is active

# Teleconsultation (Jitsi Meet — M14)
JITSI_BASE_URL="https://meet.jit.si"
