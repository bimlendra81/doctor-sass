# ---- Database (Prisma) ----
# Local MySQL / MariaDB (this repo uses XAMPP MariaDB on port 3307)
DATABASE_URL="mysql://root:@127.0.0.1:3307/doctor_saas"

# PlanetScale (serverless MySQL) alternative:
# DATABASE_URL="mysql://USER:PASSWORD@aws.connect.psdb.cloud/doctor_saas?sslaccept=strict"

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Auth (used in M2) ----
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
