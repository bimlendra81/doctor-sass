{
  "name": "doctor-sass",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Doctor SaaS platform — React (Vite) · Node.js (Express) · MySQL · GraphQL",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:studio": "npm run db:studio -w server"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.21.5": true,
    "bcrypt@6.0.0": true
  }
}
